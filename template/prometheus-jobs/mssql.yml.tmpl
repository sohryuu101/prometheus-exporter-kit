# ${STATION_NAME} mssql_exporter (sql_exporter) scrape job.
# Runs only on the main host; it polls both main and backup SQL Server
# instances itself (see config.yml.tmpl jobs.mssql_targets), so Prometheus
# only needs to scrape the exporter's own /metrics here, not the DB hosts.
job_name: soc-${STATION_NAME}-mssql
scrape_interval: 30s
scrape_timeout: 15s
metrics_path: /metrics
static_configs:
  - targets:
      - ${TARGET_IP_MAIN}:9399
    labels:
      role: main
relabel_configs:
  - source_labels: [__address__]
    target_label: target_ip
    regex: '([^:]+):.*'
    replacement: '${1}'
  - target_label: segment
    replacement: ${SEGMENT}
  - source_labels: [segment, target_ip]
    target_label: instance
    separator: '-'
  - target_label: cid
    replacement: dc1
  - target_label: station_name
    replacement: ${STATION_NAME}
  - target_label: station_id
    replacement: ${STATION_ID}
  - target_label: project
    replacement: myproject

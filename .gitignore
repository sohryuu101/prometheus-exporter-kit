# macOS
.DS_Store

# Python
__pycache__/
*.pyc

# Build output from package.sh
template/out/

# Staged upstream release archives (run prepare-offline.sh to fetch these)
template/*/dist/

# Staged Windows binaries (run prepare-offline.sh to fetch these)
template/windows-exporter/windows_exporter-*.exe
template/blackbox-exporter-windows/blackbox_exporter.exe

# Local site values — never commit real SNMP communities
template/*/vars.env
template/snmp-exporter/snmp.local.yml

# Switch probe reports: full configs, local users and SNMP communities
probe_output*.txt
HUAWEI_*.log
huawei_switch_logs/

# Staged binaries for the newer Windows kits (sql_exporter.exe is ~95 MB)
template/mssql-exporter-windows/sql_exporter.exe
template/snmp-exporter-windows/snmp_exporter.exe
